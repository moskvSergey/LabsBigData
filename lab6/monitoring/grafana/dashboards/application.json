{
  "uid": "lab6-application",
  "title": "ЛР-6 · Панель 2: Приложение (latency, RPS, ошибки, checkpoint)",
  "tags": ["lab6", "application", "sla"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Инференс: перцентили latency (SLA 100 мс / бюджет 45 мс)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {"thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 45}, {"color": "red", "value": 100}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "lab6_inference_latency_ms_ms{quantile=\"0.5\"}", "legendFormat": "p50"},
        {"refId": "B", "expr": "lab6_inference_latency_ms_ms{quantile=\"0.95\"}", "legendFormat": "p95"},
        {"refId": "C", "expr": "lab6_inference_latency_ms_ms{quantile=\"0.99\"}", "legendFormat": "p99"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Пропускная способность и ошибки",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "rate(lab6_requests_total[1m])", "legendFormat": "RPS"},
        {"refId": "B", "expr": "rate(lab6_errors_total[1m])", "legendFormat": "ошибки/с"},
        {"refId": "C", "expr": "rate(lab6_predictions_total[1m])", "legendFormat": "предсказаний/с"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLA доступность (цель >= 0.995)",
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.995}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(up{job=\"model-server\"}[1h])",
          "legendFormat": "доступность"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Spark shuffle spill и checkpoint (Flink)",
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "spark_shuffle_spill_memory", "legendFormat": "shuffle spill"},
        {"refId": "B", "expr": "flink_jobmanager_job_lastCheckpointDuration", "legendFormat": "checkpoint duration, мс"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cost per job, USD",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 4.5}, {"color": "red", "value": 6.9}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "lab6_cost_per_job_usd", "legendFormat": "cost/job"}
      ]
    }
  ]
}
