{
  "uid": "lab6-data",
  "title": "ЛР-6 · Панель 3: Качество данных (drift, schema compliance, DLQ)",
  "tags": ["lab6", "data-quality", "drift"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Data drift (PSI): порог 0.2 — critical",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 0.2}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "lab6_data_drift_psi", "legendFormat": "PSI (rating)"},
        {"refId": "B", "expr": "0.2", "legendFormat": "порог critical"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Schema compliance (цель >= 0.99)",
      "gridPos": {"h": 9, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "lab6_schema_compliance_ratio", "legendFormat": "compliance"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Записей в DLQ за час",
      "gridPos": {"h": 9, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 100}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "increase(lab6_dlq_records_total[1h])", "legendFormat": "DLQ/час"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Экономия затрат: цель 40% (вариант 8)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 40}]}
        },
        "overrides": []
      },
      "targets": [
        {"refId": "A", "expr": "lab6_cost_savings_pct", "legendFormat": "достигнутая экономия"},
        {"refId": "B", "expr": "40", "legendFormat": "требование варианта 8"}
      ]
    }
  ]
}
