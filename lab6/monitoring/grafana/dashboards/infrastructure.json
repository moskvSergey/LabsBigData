{
  "uid": "lab6-infrastructure",
  "title": "ЛР-6 · Панель 1: Инфраструктура (CPU, Memory, Network)",
  "tags": ["lab6", "infrastructure", "variant-8"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU: утилизация контейнеров (лимит vs факт)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*lab6.*\"}[2m])) / sum by (name) (container_spec_cpu_quota{name=~\".*lab6.*\"} / container_spec_cpu_period{name=~\".*lab6.*\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory: working set vs лимит пода",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{name=~\".*lab6.*\"}",
          "legendFormat": "{{name}} working set"
        },
        {
          "refId": "B",
          "expr": "container_spec_memory_limit_bytes{name=~\".*lab6.*\"}",
          "legendFormat": "{{name}} limit"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network: трафик model-server",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_network_receive_bytes_total{name=~\".*lab6.*\"}[2m])",
          "legendFormat": "rx {{name}}"
        },
        {
          "refId": "B",
          "expr": "rate(container_network_transmit_bytes_total{name=~\".*lab6.*\"}[2m])",
          "legendFormat": "tx {{name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Spot-узлы Ready (cost-стратегия варианта 8)",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "узлов Ready"
        }
      ]
    }
  ]
}
